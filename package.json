{
  "name": "freehub2copilot",
  "displayName": "Free Model Hub for Copilot",
  "description": "The free-model-hub daemon's roster — free lane, Kilo, 13 account channels, your relays — directly in Copilot Chat as a BYOK provider. Zero configuration on the machine that runs the hub.",
  "version": "0.1.0",
  "publisher": "lfapex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lfapex/freehub2copilot"
  },
  "engines": {
    "vscode": "^1.116.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "copilot",
    "github copilot",
    "free models",
    "byok",
    "free-model-hub",
    "language model",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      { "vendor": "freehub-free", "displayName": "OpenCode" },
      { "vendor": "freehub-region", "displayName": "OpenCode · region-limited" },
      { "vendor": "freehub-kilo", "displayName": "Kilo" },
      { "vendor": "freehub-atomcode", "displayName": "AtomCode" },
      { "vendor": "freehub-codearts", "displayName": "CodeArts Agent" },
      { "vendor": "freehub-buddy", "displayName": "CodeBuddy (腾讯)" },
      { "vendor": "freehub-workbuddy", "displayName": "WorkBuddy (国际版)" },
      { "vendor": "freehub-lobsterai", "displayName": "LobsterAI (有道)" },
      { "vendor": "freehub-qoder", "displayName": "Qoder" },
      { "vendor": "freehub-qodercn", "displayName": "Qoder (中国版)" },
      { "vendor": "freehub-trae", "displayName": "TRAE (字节)" },
      { "vendor": "freehub-cline", "displayName": "Cline" },
      { "vendor": "freehub-loomy", "displayName": "Loomy (讯飞)" },
      { "vendor": "freehub-raccoon", "displayName": "Raccoon (商汤)" },
      { "vendor": "freehub-minimax", "displayName": "MiniMax Code" },
      { "vendor": "freehub-zcode", "displayName": "ZCode (智谱)" },
      { "vendor": "freehub-opencode", "displayName": "OpenCode" },
      { "vendor": "freehub-gemini", "displayName": "Gemini Code Assist" },
      { "vendor": "freehub-relay", "displayName": "Relay" },
      { "vendor": "freehub-virtual", "displayName": "Virtual" },
      { "vendor": "freehub", "displayName": "Free Model Hub" }
    ],
    "commands": [
      {
        "command": "freehub.showStatus",
        "title": "Free Model Hub: Show Connection Status"
      },
      {
        "command": "freehub.refreshModels",
        "title": "Free Model Hub: Refresh Model Catalog"
      },
      {
        "command": "freehub.showLogs",
        "title": "Free Model Hub: Show Logs"
      }
    ],
    "configuration": {
      "title": "Free Model Hub for Copilot",
      "properties": {
        "freehub.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8330",
          "description": "The hub's OpenAI-compatible base URL. The default serves the local daemon; change it only when the hub runs on another machine."
        },
        "freehub.apiKey": {
          "type": "string",
          "default": "",
          "description": "The hub's server key. Leave empty to auto-read it from the local hub's data directory (~/.free-model-hub/hub/settings.json) — zero configuration on the machine that runs the hub."
        },
        "freehub.refreshSeconds": {
          "type": "number",
          "default": 300,
          "description": "How often the model catalog is re-read from the hub (channels logging in, relays added — all flow through)."
        },
        "freehub.debug": {
          "type": "boolean",
          "default": false,
          "description": "Verbose logging (Output: Free Model Hub for Copilot)."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist/freehub2copilot-0.1.0.vsix",
    "smoke": "node --test scripts/smoke.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.9.2"
  }
}
